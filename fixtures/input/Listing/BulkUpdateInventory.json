{
  "cases": [
    {
      "label": "empty inventory array",
      "input": {
        "inventory": []
      },
      "expected": {
        "inventory": []
      }
    },
    {
      "label": "single item with listingItemIdentifier fields",
      "input": {
        "inventory": [
          {
            "listingItemIdentifier": {
              "listingId": "123456"
            }
          }
        ]
      },
      "expected": {
        "inventory": [
          {
            "listingItemIdentifier": {
              "listingId": "123456"
            }
          }
        ]
      }
    },
    {
      "label": "single item with price and quantity",
      "input": {
        "inventory": [
          {
            "listingItemIdentifier": {
              "listingId": "123456",
              "lineItemId": "1"
            },
            "fixedPrice": {
              "value": "9.99",
              "currency": "USD"
            },
            "availableQuantity": 5
          }
        ]
      },
      "expected": {
        "inventory": [
          {
            "listingItemIdentifier": {
              "listingId": "123456",
              "lineItemId": "1"
            },
            "fixedPrice": {
              "value": "9.99",
              "currency": "USD"
            },
            "availableQuantity": 5
          }
        ]
      }
    }
  ]
}
