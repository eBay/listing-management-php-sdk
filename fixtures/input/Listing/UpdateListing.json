{
  "cases": [
    {
      "label": "empty input",
      "input": {},
      "expected": {}
    },
    {
      "label": "with listingIdentifier and marketplace",
      "input": {
        "listingIdentifier": {
          "listingId": "345678"
        },
        "marketplace": "EBAY_AT"
      },
      "expected": {
        "listingIdentifier": {
          "listingId": "345678"
        },
        "marketplace": "EBAY_AT"
      }
    },
    {
      "label": "with listingIdentifier and price update",
      "input": {
        "listingIdentifier": {
          "listingId": "345678"
        },
        "marketplace": "EBAY_GB",
        "listingItems": {
          "items": [
            {
              "itemTerms": {
                "pricingTerms": {
                  "fixedPrice": {
                    "value": "19.99",
                    "currency": "GBP"
                  }
                }
              }
            }
          ]
        }
      },
      "expected": {
        "listingIdentifier": {
          "listingId": "345678"
        },
        "marketplace": "EBAY_GB",
        "listingItems": {
          "items": [
            {
              "itemTerms": {
                "pricingTerms": {
                  "fixedPrice": {
                    "value": "19.99",
                    "currency": "GBP"
                  }
                }
              }
            }
          ]
        }
      }
    }
  ]
}
