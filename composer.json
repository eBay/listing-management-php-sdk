{
  "name": "ebay/listing-management-php-sdk",
  "description": "ListingManagement PHP SDK",
  "type": "library",
  "require": {
    "php": ">=8.2",
    "microsoft/kiota-bundle": "^2.0",
    "microsoft/kiota-authentication-phpleague": "^2.0",
    "guzzlehttp/guzzle": "^7.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "phpstan/phpstan": "^1.10"
  },
  "autoload": {
    "psr-4": {
      "EBay\\ListingManagement\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "EBay\\ListingManagement\\Tests\\": "tests/"
    }
  }
}
